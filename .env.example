# Exact deployed origin used to reject cross-site enquiry submissions.
SITE_URL=http://localhost:3000

# Production canonical URL used in static metadata, sitemap, and structured data.
CANONICAL_SITE_URL=https://saiworldtravels.in

# Keep false for local, preview, and demo builds. Enable only at the final production gate.
SITE_INDEXING_ENABLED=false

# Server-only Supabase settings. Use a current sb_secret_* key in deployed environments.
# Never rename the secret to a NEXT_PUBLIC_* variable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
